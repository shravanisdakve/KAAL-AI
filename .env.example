# DATABASE_URL: PostgreSQL connection string (e.g. postgres://user:password@localhost:5432/kaal_db)
# If not provided, KAAL AI operates gracefully with local persistent storage.
DATABASE_URL="postgres://user:password@localhost:5432/kaal_db"

# PORT: Server port (defaults to 3000)
PORT="3000"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
